{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["preset","agent","brand","copy","services","testimonials","stats","featuredListings","neighbourhoods","seo","admins","consent","apv"],
  "properties": {
    "$schema": {"type":"string"},
    "preset": {"enum":["luxury-editorial","neighbourhood-journal","modern-team"]},
    "agent": {"type":"object","additionalProperties":false,"required":["name","title","brokerage","licenseLabel","licenseNumber","markets","biography","email","phone","officeAddress","logo","headshot","social"],"properties":{"name":{"type":"string","minLength":2},"pronouns":{"type":"string"},"title":{"type":"string"},"brokerage":{"type":"string","minLength":2},"licenseLabel":{"type":"string"},"licenseNumber":{"type":"string"},"markets":{"type":"array","minItems":1,"items":{"type":"string"}},"biography":{"type":"string","minLength":40},"email":{"type":"string","format":"email"},"phone":{"type":"string"},"officeAddress":{"type":"string"},"logo":{"type":"string"},"headshot":{"type":"string"},"social":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","url"],"properties":{"label":{"type":"string"},"url":{"type":"string","format":"uri"}}}}}},
    "brand":{"type":"object","additionalProperties":false,"required":["primary","accent","paper","ink","displayFont","bodyFont"],"properties":{"primary":{"$ref":"#/$defs/colour"},"accent":{"$ref":"#/$defs/colour"},"paper":{"$ref":"#/$defs/colour"},"ink":{"$ref":"#/$defs/colour"},"displayFont":{"type":"string"},"bodyFont":{"type":"string"}}},
    "copy":{"type":"object","additionalProperties":false,"required":["eyebrow","headline","introduction","valuationCta","contactNote"],"properties":{"eyebrow":{"type":"string"},"headline":{"type":"string"},"introduction":{"type":"string"},"valuationCta":{"type":"string"},"contactNote":{"type":"string"}}},
    "services":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/titledText"}},
    "testimonials":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["quote","attribution","verified"],"properties":{"quote":{"type":"string"},"attribution":{"type":"string"},"verified":{"const":true}}}},
    "stats":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","value","verified"],"properties":{"label":{"type":"string"},"value":{"type":"string"},"verified":{"const":true}}}},
    "featuredListings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","address","city","price","beds","baths","image","alt","url","manual"],"properties":{"id":{"type":"string"},"status":{"type":"string"},"address":{"type":"string"},"city":{"type":"string"},"price":{"type":"string"},"beds":{"type":"number"},"baths":{"type":"number"},"image":{"type":"string"},"alt":{"type":"string"},"url":{"type":"string"},"manual":{"const":true}}}},
    "neighbourhoods":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","summary","link"],"properties":{"name":{"type":"string"},"summary":{"type":"string"},"link":{"type":"string"}}}},
    "seo":{"type":"object","additionalProperties":false,"required":["siteUrl","title","description","locale"],"properties":{"siteUrl":{"type":"string","format":"uri"},"title":{"type":"string"},"description":{"type":"string"},"locale":{"type":"string"}}},
    "admins":{"type":"array","minItems":1,"items":{"type":"string","format":"email"}},
    "consent":{"type":"object","additionalProperties":false,"required":["privacyUrl","requiredLabel","marketingOptionalLabel","disclaimer"],"properties":{"privacyUrl":{"type":"string","format":"uri"},"requiredLabel":{"type":"string"},"marketingOptionalLabel":{"type":"string"},"disclaimer":{"type":"string"}}},
    "apv":{"type":"object","additionalProperties":false,"required":["mediaConsultationUrl","mediaPlanningUrl","footerLabel"],"properties":{"mediaConsultationUrl":{"const":"https://amazingphotovideo.com"},"mediaPlanningUrl":{"const":"https://amazingphotovideo.com"},"footerLabel":{"type":"string","pattern":"Amazing Photo Video"}}}
  },
  "$defs":{"colour":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},"titledText":{"type":"object","additionalProperties":false,"required":["title","description"],"properties":{"title":{"type":"string"},"description":{"type":"string"}}}}
}
